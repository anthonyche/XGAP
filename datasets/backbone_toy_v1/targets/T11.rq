?n2 t:id ?id2 .
BIND(CONCAT(?id0, "/", ?eid1, "/", ?id1, "/", ?eid2, "/", ?id2) AS ?path)
BIND(?id0 AS ?start)
BIND(?id2 AS ?finish)
BIND(2 AS ?length)
}
