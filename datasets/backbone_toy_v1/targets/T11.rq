?n3 t:id ?id3 .
BIND(CONCAT(?id0, "/", ?eid1, "/", ?id1, "/", ?eid2, "/", ?id2, "/", ?eid3, "/", ?id3) AS ?path)
BIND(?id0 AS ?start)
BIND(?id3 AS ?finish)
BIND(3 AS ?length)
} } } FILTER NOT EXISTS { { SELECT DISTINCT ?pathOther ?startOther ?finishOther ?lengthOther WHERE { {
?n0Other a t:Person ; t:id ?id0Other .
FILTER(?id0Other = "a")
