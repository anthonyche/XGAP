PREFIX t: <https://xgap.test/toy/>
SELECT DISTINCT ?path WHERE { { SELECT DISTINCT ?path ?start ?finish ?length WHERE { {
?n0 a t:Person ; t:id ?id0 .
FILTER(?id0 = "a")
?e1 a t:Edge ; t:label "KNOWS" ; t:id ?eid1 ; t:source ?n0 ; t:target ?n1 .
?n1 t:id ?id1 .
BIND(CONCAT(?id0, "/", ?eid1, "/", ?id1) AS ?path)
BIND(?id0 AS ?start)
BIND(?id1 AS ?finish)
BIND(1 AS ?length)
} } } } ORDER BY ?path
