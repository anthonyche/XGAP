PREFIX t: <https://xgap.test/toy/>
SELECT DISTINCT (CONCAT(?nid0, "/", ?eid1, "/", ?nid1, "/", ?eid2, "/", ?nid2) AS ?path) WHERE { VALUES ?n0 {t:b} VALUES ?n2 {t:b} 
?e1 a t:Edge ; t:label "KNOWS" ; t:id ?eid1 . { ?e1 t:source ?n0 ; t:target ?n1 . } UNION { ?e1 t:source ?n1 ; t:target ?n0 . }
?e2 a t:Edge ; t:label "KNOWS" ; t:id ?eid2 . { ?e2 t:source ?n1 ; t:target ?n2 . } UNION { ?e2 t:source ?n2 ; t:target ?n1 . }
?n0 t:id ?nid0 . ?n1 t:id ?nid1 . ?n2 t:id ?nid2 .
FILTER(?n0 != ?n1 && ?n0 != ?n2 && ?n1 != ?n2) }
