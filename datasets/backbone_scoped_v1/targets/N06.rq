PREFIX t: <https://xgap.test/toy/>
SELECT DISTINCT ?path WHERE { {
SELECT DISTINCT ?path ?src ?dst ?length WHERE {
{ SELECT DISTINCT ?path ?src ?dst ?length WHERE {
?n0 a t:Person .
?n0 t:id ?nid0 .
BIND(?nid0 AS ?path)
BIND(?nid0 AS ?src)
BIND(?nid0 AS ?dst)
BIND(0 AS ?length)
} }
UNION
{ SELECT DISTINCT ?path ?src ?dst ?length WHERE {
{ SELECT DISTINCT ?path ?src ?dst ?length WHERE {
{ SELECT DISTINCT ?path ?src ?dst ?length WHERE {
?e1 a t:Edge ; t:label "KNOWS" ; t:id ?eid1 ; t:source ?n0 ; t:target ?n1 .
?n0 t:id ?nid0 .
?n1 t:id ?nid1 .
BIND(CONCAT(?nid0, "/", ?eid1, "/", ?nid1) AS ?path)
BIND(?nid0 AS ?src)
BIND(?nid1 AS ?dst)
BIND(1 AS ?length)
} }
UNION
{ SELECT DISTINCT ?path ?src ?dst ?length WHERE {
?e1 a t:Edge ; t:label "KNOWS" ; t:id ?eid1 ; t:source ?n0 ; t:target ?n1 .
?e2 a t:Edge ; t:label "KNOWS" ; t:id ?eid2 ; t:source ?n1 ; t:target ?n2 .
?n0 t:id ?nid0 .
?n1 t:id ?nid1 .
?n2 t:id ?nid2 .
BIND(CONCAT(?nid0, "/", ?eid1, "/", ?nid1, "/", ?eid2, "/", ?nid2) AS ?path)
BIND(?nid0 AS ?src)
BIND(?nid2 AS ?dst)
BIND(2 AS ?length)
} }
} }
{ SELECT ?src ?dst (MIN(?cost) AS ?best) WHERE { { SELECT DISTINCT ?path ?src ?dst ?cost WHERE {
{ SELECT DISTINCT ?path ?src ?dst ?cost WHERE {
?e1 a t:Edge ; t:label "KNOWS" ; t:id ?eid1 ; t:source ?n0 ; t:target ?n1 .
?n0 t:id ?nid0 .
?n1 t:id ?nid1 .
BIND(CONCAT(?nid0, "/", ?eid1, "/", ?nid1) AS ?path)
BIND(?nid0 AS ?src)
BIND(?nid1 AS ?dst)
BIND(1 AS ?cost)
} }
UNION
{ SELECT DISTINCT ?path ?src ?dst ?cost WHERE {
?e1 a t:Edge ; t:label "KNOWS" ; t:id ?eid1 ; t:source ?n0 ; t:target ?n1 .
?e2 a t:Edge ; t:label "KNOWS" ; t:id ?eid2 ; t:source ?n1 ; t:target ?n2 .
?n0 t:id ?nid0 .
?n1 t:id ?nid1 .
?n2 t:id ?nid2 .
BIND(CONCAT(?nid0, "/", ?eid1, "/", ?nid1, "/", ?eid2, "/", ?nid2) AS ?path)
BIND(?nid0 AS ?src)
BIND(?nid2 AS ?dst)
BIND(2 AS ?cost)
} }
} } } GROUP BY ?src ?dst }
FILTER(?length = ?best)
} }
}
} FILTER(?src = "d" && ?dst = "d") }
