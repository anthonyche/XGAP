PREFIX t: <https://xgap.test/toy/>
SELECT DISTINCT (STR(?n) AS ?person) ?score ?flag WHERE {
?n a t:Person ; t:id ?nid .
OPTIONAL { ?n t:score ?score . }
OPTIONAL { ?n t:note ?note . }
OPTIONAL { ?n t:flag ?flag . }
FILTER((COALESCE(?score = 1, false) || COALESCE(?score = true, false)) || COALESCE(?note = "open",false))
BIND(?nid AS ?path)
}
