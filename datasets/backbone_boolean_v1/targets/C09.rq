PREFIX t: <https://xgap.test/toy/>
SELECT DISTINCT ?path WHERE {
?e a t:Edge ; t:source ?n ; t:target ?m ; t:id ?eid ; t:label ?edgeLabel .
?n t:id ?nid . ?m t:id ?mid .
OPTIONAL { ?e t:weight ?weight . }
FILTER((COALESCE(?weight = 1, false) || COALESCE(?weight = true, false)) || ?edgeLabel != "KNOWS")
BIND(CONCAT(?nid, "/", ?eid, "/", ?mid) AS ?path)
}
