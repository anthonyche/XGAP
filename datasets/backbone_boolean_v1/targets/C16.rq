PREFIX t: <https://xgap.test/toy/>
SELECT DISTINCT ?path WHERE {
{ SELECT ?path ?src ?dst ?len ?second WHERE {
{ ?e1 a t:Edge ; t:label "KNOWS" ; t:id ?eid1 ; t:source ?n0 ; t:target ?n1 .
?n0 t:id ?nid0 .
?n1 t:id ?nid1 .
BIND(CONCAT(?nid0, "/", ?eid1, "/", ?nid1) AS ?path)
BIND(?nid0 AS ?src)
BIND(?nid1 AS ?dst)
BIND(1 AS ?len)
BIND(?nid1 AS ?second) }
UNION
{ ?e1 a t:Edge ; t:label "KNOWS" ; t:id ?eid1 ; t:source ?n0 ; t:target ?n1 .
?e2 a t:Edge ; t:label "KNOWS" ; t:id ?eid2 ; t:source ?n1 ; t:target ?n2 .
?n0 t:id ?nid0 .
?n1 t:id ?nid1 .
?n2 t:id ?nid2 .
BIND(CONCAT(?nid0, "/", ?eid1, "/", ?nid1, "/", ?eid2, "/", ?nid2) AS ?path)
BIND(?nid0 AS ?src)
BIND(?nid2 AS ?dst)
BIND(2 AS ?len)
BIND(?nid1 AS ?second) }
UNION
{ ?e1 a t:Edge ; t:label "KNOWS" ; t:id ?eid1 ; t:source ?n0 ; t:target ?n1 .
?e2 a t:Edge ; t:label "KNOWS" ; t:id ?eid2 ; t:source ?n1 ; t:target ?n2 .
?e3 a t:Edge ; t:label "KNOWS" ; t:id ?eid3 ; t:source ?n2 ; t:target ?n3 .
?n0 t:id ?nid0 .
?n1 t:id ?nid1 .
?n2 t:id ?nid2 .
?n3 t:id ?nid3 .
BIND(CONCAT(?nid0, "/", ?eid1, "/", ?nid1, "/", ?eid2, "/", ?nid2, "/", ?eid3, "/", ?nid3) AS ?path)
BIND(?nid0 AS ?src)
BIND(?nid3 AS ?dst)
BIND(3 AS ?len)
BIND(?nid1 AS ?second) }
} }
FILTER((?len = 1) || (?len = 2 && !EXISTS { ?s t:id ?src ; t:KNOWS ?o . ?o t:id ?dst . }) || (?len = 3 && !EXISTS { ?s t:id ?src ; (t:KNOWS|t:KNOWS/t:KNOWS) ?o . ?o t:id ?dst . }))
FILTER(?src = "a" && (?dst IN ("c","z")))
}
