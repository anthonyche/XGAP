# Reproducible benchmark data products. Keep compact manifests/summaries in
# Git; fetch or rebuild query-level artifacts on the experiment server.
datasets/grailqa_audit/*.jsonl
datasets/grailqa_audit_v2/*.jsonl
datasets/grailqa_audit_v2/normalized_ontology.yaml
datasets/grailqa_audit_v2/ontology_normalization.json
datasets/kqapro_audit/*.jsonl

datasets/grailqa_inference_catalog_v1/*
!datasets/grailqa_inference_catalog_v1/manifest.json

datasets/grailqa_inference_catalog_v2/*
!datasets/grailqa_inference_catalog_v2/manifest.json
datasets/grailqa_inference_catalog_v2/*.sqlite
datasets/grailqa_inference_catalog_v2/*.sqlite3
datasets/grailqa_inference_catalog_v2/*.db

datasets/grailqa_reachability_v2/*
!datasets/grailqa_reachability_v2/manifest.json
!datasets/grailqa_reachability_v2/audit_summary.json
!datasets/grailqa_reachability_v2/catalog_coverage.json
!datasets/grailqa_reachability_v2/retrieval_metrics.json
!datasets/grailqa_reachability_v2/prompt_reachability.json
!datasets/grailqa_reachability_v2/stage_failure_counts.json
!datasets/grailqa_reachability_v2/manifest_reference.json

datasets/grailqa_m13d_reachability_baseline/*
!datasets/grailqa_m13d_reachability_baseline/manifest.json
!datasets/grailqa_m13d_reachability_baseline/summary.json

datasets/grailqa_pilot_v1/*
!datasets/grailqa_pilot_v1/artifact_manifest.json
!datasets/grailqa_pilot_v1/inference_manifest.json
!datasets/grailqa_pilot_v1/pilot_ids.json
datasets/*.pre-m13d-*

