# Paper-grade XGAP backend environment.
# Copy to services/.env.paper and fill both image references from the
# CURRENT validated server images. Paper scripts reject missing/floating values.

COMPOSE_PROJECT_NAME=xgap-lab

# Required immutable image references, for example repository@sha256:<64 hex>.
# NEO4J_IMAGE=
# FUSEKI_IMAGE=

NEO4J_USER=neo4j
NEO4J_PASSWORD=xgap-lab-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

FUSEKI_ADMIN_USER=admin
FUSEKI_ADMIN_PASSWORD=xgap-lab-password
FUSEKI_PORT=3030
FUSEKI_DATASET_NAME=xgap

# Optional backend-reported versions for freeze manifests when automatic
# discovery is unavailable.
# NEO4J_SOFTWARE_VERSION=
# FUSEKI_SOFTWARE_VERSION=
