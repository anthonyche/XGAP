# XGAP backend development environment.
# Copy this file to services/.env before starting services.
# Floating references are tolerated only for development. Use
# services/.env.paper.example and XGAP_PAPER_ENV=1 for a frozen paper run.

COMPOSE_PROJECT_NAME=xgap-lab

# Neo4j
NEO4J_IMAGE=neo4j:5-community
NEO4J_USER=neo4j
NEO4J_PASSWORD=xgap-lab-password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# Apache Jena Fuseki
# This image runs Apache Jena Fuseki. Paper runs require the digest-pinned
# contract in services/.env.paper.
FUSEKI_IMAGE=stain/jena-fuseki:latest
FUSEKI_ADMIN_USER=admin
FUSEKI_ADMIN_PASSWORD=xgap-lab-password
FUSEKI_PORT=3030
FUSEKI_DATASET_NAME=xgap
