{
  "schema_version": "xgap-refined-modes-native-fixture-v1",
  "population": "independent-mode-development",
  "exposure": "New start-account question on the frozen eight-entity/sixteen-relation development graph; not an evaluation question.",
  "derivation": "Account2 has two outgoing transfers: account3 on Jan2 and account4 on Jan1. Each has blocked medium1/PHONE. The path through account3 to account1 has no signed-in medium there; a further edge returning to account2 repeats the start, and another to account3 fails increasing time. Thus exactly two one-hop rows.",
  "case": {
    "id": "REFINED-MODES-ACCOUNT-2",
    "question": "From the account whose business ID is \"2\", follow one to three outgoing TRANSFERRED_TO edges between 2020-01-01 00:00:00.000 and 2020-01-04 00:00:00.000 inclusive. Transfer timestamps must strictly increase and no account may repeat. For each reachable account with a blocked medium signed in, return other_id (account business ID), account_distance (path length), medium_id (medium business ID), and medium_type. Sort by account_distance, other_id, medium_id ascending.",
    "gold_compact": {
      "nodes": [
        {
          "var": "start",
          "type": "XGAPFinBenchAccount",
          "entity": null
        },
        {
          "var": "other",
          "type": "XGAPFinBenchAccount",
          "entity": null
        },
        {
          "var": "medium",
          "type": "XGAPFinBenchMedium",
          "entity": null
        }
      ],
      "edges": [
        {
          "var": "signin",
          "type": "SIGNED_IN_TO",
          "source": "medium",
          "target": "other"
        }
      ],
      "path": {
        "var": "reach",
        "type": "TRANSFERRED_TO",
        "source": "start",
        "target": "other",
        "min_hops": 1,
        "max_hops": 3,
        "mode": "ACYCLIC",
        "time": {
          "property": "createTime",
          "lower": "2020-01-01 00:00:00.000",
          "upper": "2020-01-04 00:00:00.000",
          "lower_inclusive": true,
          "upper_inclusive": true,
          "increasing": true
        }
      },
      "where": [
        {
          "left": {
            "var": "start",
            "property": "id"
          },
          "op": "eq",
          "right": {
            "value": "2"
          },
          "value_type": "scalar"
        },
        {
          "left": {
            "var": "medium",
            "property": "isBlocked"
          },
          "op": "eq",
          "right": {
            "value": true
          },
          "value_type": "scalar"
        }
      ],
      "select": {
        "other_id": {
          "var": "other",
          "property": "id"
        },
        "account_distance": {
          "var": "reach",
          "property": "length"
        },
        "medium_id": {
          "var": "medium",
          "property": "id"
        },
        "medium_type": {
          "var": "medium",
          "property": "mediumType"
        }
      },
      "contribution_by": null,
      "order_by": [
        {
          "field": "account_distance",
          "direction": "asc"
        },
        {
          "field": "other_id",
          "direction": "asc"
        },
        {
          "field": "medium_id",
          "direction": "asc"
        }
      ],
      "limit": null
    },
    "expected_rows": [
      {
        "other_id": "3",
        "account_distance": 1,
        "medium_id": "1",
        "medium_type": "PHONE"
      },
      {
        "other_id": "4",
        "account_distance": 1,
        "medium_id": "1",
        "medium_type": "PHONE"
      }
    ],
    "normalization": {
      "schema_version": "xgap-row-normalization-v1",
      "fields": {
        "other_id": "text",
        "account_distance": "integer",
        "medium_id": "text",
        "medium_type": "text"
      }
    }
  }
}
