  "sealed_before_service_start": true,
  "answer_oracle_opened_after_all_successful_executions": true,
  "current_query_profile_calls": 0,
  "llm_calls_made": 0,
  "ontology_service_calls_made": 0,
  "automatic_retries": 0,
  "paper_result": false
